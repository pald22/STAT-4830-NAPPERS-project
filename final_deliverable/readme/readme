# 5. Run prediction-market panel experiments
python scripts/run_panel_experiments.py \
  --csv data/prediction_market/polymarket_daily_panel_60plus.csv \
  --out Outputs/polymarket_panel_experiments

# 6. Optional: run Polymarket mispricing optimizer
python scripts/run_polymarket_mispricing.py \
  --csv data/prediction_market/polymarket_daily_panel_60plus.csv \
  --out Outputs/polymarket_mispricing

# 7. Run final deliverable notebooks
jupyter notebook final_deliverable/implementation_code/demo_01_standalone_optimization_equity_and_polymarket.ipynb
